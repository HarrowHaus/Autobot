{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent profile",
  "description": "Structural validation, not a proof of wallet ownership or competence.",
  "type": "object",
  "required": ["name", "bio", "skills", "wallet_address"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S"},
    "bio": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
    "skills": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "\\S"}},
    "wallet_address": {"type": "string", "minLength": 42, "maxLength": 42, "pattern": "^0x[0-9a-fA-F]{40}$"}
  }
}
