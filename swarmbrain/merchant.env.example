# Copy into deployment environment; do not commit real credentials.
# Merchant stays off unless explicitly enabled.
A0_MERCHANT_ENABLED=0

# Public HTTPS origin serving swarmbrain/merchant_server.py
A0_MERCHANT_PUBLIC_URL=https://merchant.example

# Public EVM payout address only. Never place a private key or seed phrase here.
A0_PAY_TO=0x0000000000000000000000000000000000000000

# USDC token contract for the selected EVM network.
A0_USDC_ASSET=0x0000000000000000000000000000000000000000

# x402 facilitator base URL. Must be HTTPS.
A0_FACILITATOR_URL=https://facilitator.example

# If the facilitator requires authentication, inject at runtime from a secret store:
# A0_FACILITATOR_HEADERS_JSON={"Authorization":"Bearer <deployment-secret>"}

# Exact USDC atomic units charged per read-only routing request.
A0_ROUTE_PRICE_ATOMIC=10000

# Base mainnet by default.
A0_PAYMENT_NETWORK=eip155:8453

# Local bind defaults are intentionally non-public.
A0_MERCHANT_HOST=127.0.0.1
A0_MERCHANT_PORT=8787
